---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import TechLandscape from '../../../components/sections/TechLandscape.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('tech.heading')} — ${t('site.title')}`} description={t('tech.intro')} route="tech">
  <Header lang={lang} route="tech" />
  <main id="main">
    <TechLandscape lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
