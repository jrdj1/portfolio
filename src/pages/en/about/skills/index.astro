---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Skills from '../../../../components/sections/Skills.astro';
import { useTranslations } from '../../../../i18n/utils';
import { routePath } from '../../../../i18n/routes';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('skills.heading')} — ${t('site.title')}`} description={t('about.skills.desc')} route="aboutSkills">
  <Header lang={lang} route="aboutSkills" />
  <main id="main">
    <Skills lang={lang} />
    <div class="px-6 pb-16">
      <div class="mx-auto max-w-4xl">
        <a
          href={routePath(lang, 'about')}
          class="inline-block rounded border border-[var(--color-border)] px-4 py-2 text-sm font-medium transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          {t('about.back')}
        </a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
