---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Education from '../../../components/sections/Education.astro';
import { useTranslations } from '../../../i18n/utils';
import { routePath } from '../../../i18n/routes';

const lang = 'es';
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('education.heading')} — ${t('site.title')}`} description={t('about.education.desc')} route="aboutEducation">
  <Header lang={lang} route="aboutEducation" />
  <main id="main">
    <Education lang={lang} />
    <div class="px-6 pb-16">
      <div class="mx-auto max-w-4xl">
        <a
          href={routePath(lang, 'about')}
          class="inline-block rounded border border-[var(--color-border)] px-4 py-2 text-sm font-medium transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          {t('about.back')}
        </a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
