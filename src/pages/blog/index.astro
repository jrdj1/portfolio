---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('blog.heading')} — ${t('site.title')}`} description={t('blog.comingSoon')} path="/blog">
  <Header lang={lang} />
  <main id="main">
    <section class="px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-4xl">
        <h1 class="text-3xl font-bold sm:text-4xl">{t('blog.heading')}</h1>
        <p class="mt-4 max-w-xl text-[var(--color-text-muted)]">{t('blog.comingSoon')}</p>
        <a
          href={getRelativeLocaleUrl(lang, '/')}
          class="mt-8 inline-block rounded border border-[var(--color-border)] px-4 py-2 text-sm font-medium transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          ← {t('blog.back')}
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
