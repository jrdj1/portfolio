---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { routePath, type RouteKey } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries: Array<{ title: string; desc: string; route: RouteKey }> = [
  { title: t('about.skills.title'), desc: t('about.skills.desc'), route: 'aboutSkills' },
  { title: t('about.experience.title'), desc: t('about.experience.desc'), route: 'aboutExperience' },
  { title: t('about.education.title'), desc: t('about.education.desc'), route: 'aboutEducation' },
  { title: t('about.contact.title'), desc: t('about.contact.desc'), route: 'aboutContact' },
];
---

<section aria-labelledby="about-explore-heading" class="border-t border-[var(--color-border)] px-6 py-16">
  <div class="mx-auto max-w-4xl" data-reveal>
    <h2 id="about-explore-heading" class="font-mono text-sm text-[var(--color-accent)]">{t('about.exploreHeading')}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => (
        <li>
          <a
            href={routePath(lang, entry.route)}
            class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-accent-muted)]"
          >
            <span class="font-semibold transition-colors group-hover:text-[var(--color-accent)]">{entry.title}</span>
            <span class="mt-2 text-sm text-[var(--color-text-muted)]">{entry.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
