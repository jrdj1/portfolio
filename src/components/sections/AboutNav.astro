---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { routePath } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = [
  {
    title: t('about.skills.title'),
    desc: t('about.skills.desc'),
    href: routePath(lang, 'aboutSkills'),
    icon: 'm8 8-4 4 4 4M16 8l4 4-4 4',
  },
  {
    title: t('about.experience.title'),
    desc: t('about.experience.desc'),
    href: routePath(lang, 'aboutExperience'),
    icon: 'M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1ZM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18',
  },
  {
    title: t('about.education.title'),
    desc: t('about.education.desc'),
    href: routePath(lang, 'aboutEducation'),
    icon: 'M2 9 12 4l10 5-10 5-10-5ZM6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5',
  },
  {
    title: t('about.contact.title'),
    desc: t('about.contact.desc'),
    href: routePath(lang, 'aboutContact'),
    icon: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM3 7l9 6 9-6',
  },
];
---

<section aria-labelledby="about-explore-heading" class="border-t border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-16">
  <div class="mx-auto max-w-4xl" data-reveal>
    <h2 id="about-explore-heading" class="font-mono text-sm text-[var(--color-accent)]">{t('about.exploreHeading')}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => (
        <li>
          <a
            href={entry.href}
            class="group flex h-full flex-col rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg)] p-5 shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent-muted)] hover:shadow-[var(--shadow-card-hover)]"
          >
            <svg
              class="h-5 w-5 text-[var(--color-accent)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={entry.icon}></path>
            </svg>
            <span class="mt-3 font-semibold transition-colors group-hover:text-[var(--color-accent)]">{entry.title}</span>
            <span class="mt-2 text-sm text-[var(--color-text-muted)]">{entry.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
