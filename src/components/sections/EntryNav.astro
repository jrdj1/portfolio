---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { routePath } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = [
  {
    title: t('entry.projects.title'),
    desc: t('entry.projects.desc'),
    href: routePath(lang, 'projects'),
    icon: 'M12 3 3 8l9 5 9-5-9-5ZM3 16l9 5 9-5M3 12l9 5 9-5',
  },
  {
    title: t('entry.tech.title'),
    desc: t('entry.tech.desc'),
    href: routePath(lang, 'tech'),
    icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18',
  },
  {
    title: t('entry.blog.title'),
    desc: t('entry.blog.desc'),
    href: routePath(lang, 'blog'),
    icon: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2ZM8 8h8M8 12h8M8 16h5',
  },
  {
    title: t('entry.about.title'),
    desc: t('entry.about.desc'),
    href: routePath(lang, 'about'),
    icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 20c1.5-4 4.5-6 8-6s6.5 2 8 6',
  },
];
---

<section aria-label={t('nav.projects')} class="border-t border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-4xl" data-reveal>
    <ul class="grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => (
        <li>
          <a
            href={entry.href}
            class="group flex h-full flex-col rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg)] p-6 shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent-muted)] hover:shadow-[var(--shadow-card-hover)]"
          >
            <svg
              class="h-6 w-6 text-[var(--color-accent)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={entry.icon}></path>
            </svg>
            <span class="mt-3 font-semibold transition-colors group-hover:text-[var(--color-accent)]">{entry.title}</span>
            <span class="mt-2 text-sm text-[var(--color-text-muted)]">{entry.desc}</span>
            <span class="mt-4 font-mono text-sm text-[var(--color-accent)]" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
