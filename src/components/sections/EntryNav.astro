---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { routePath, type RouteKey } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries: Array<{ title: string; desc: string; route: RouteKey }> = [
  { title: t('entry.projects.title'), desc: t('entry.projects.desc'), route: 'projects' },
  { title: t('entry.tech.title'), desc: t('entry.tech.desc'), route: 'tech' },
  { title: t('entry.blog.title'), desc: t('entry.blog.desc'), route: 'blog' },
  { title: t('entry.about.title'), desc: t('entry.about.desc'), route: 'about' },
];
---

<section aria-label={t('nav.projects')} class="px-6 pb-20 sm:pb-28">
  <div class="mx-auto max-w-4xl" data-reveal>
    <ul class="grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => (
        <li>
          <a
            href={routePath(lang, entry.route)}
            class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-accent-muted)]"
          >
            <span class="font-semibold transition-colors group-hover:text-[var(--color-accent)]">{entry.title}</span>
            <span class="mt-2 text-sm text-[var(--color-text-muted)]">{entry.desc}</span>
            <span class="mt-4 font-mono text-sm text-[var(--color-accent)]" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
