---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { skills } = profile[lang];
---

<section id="skills" aria-labelledby="skills-heading" class="scroll-mt-24 border-t border-[var(--color-border)] px-6 py-16">
  <div class="mx-auto max-w-4xl">
    <h2 id="skills-heading" class="text-2xl font-bold sm:text-3xl">{t('skills.heading')}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {skills.map((group) => (
        <div>
          <h3 class="font-mono text-sm text-[var(--color-accent)]">{group.category}</h3>
          <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-[var(--color-text-muted)]">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
