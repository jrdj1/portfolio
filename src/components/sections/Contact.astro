---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">{t('contact.heading')}</h2>
  <p>{t('contact.body')}</p>
  <p><a href="mailto:jorgejulianvicedo03@gmail.com">jorgejulianvicedo03@gmail.com</a></p>
  <p>
    <a href="/cv/cv-es.pdf" download>{t('contact.cvEs')}</a>
    <a href="/cv/cv-en.pdf" download>{t('contact.cvEn')}</a>
  </p>
</section>
