---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { education } = profile[lang];
---

<section id="education" aria-labelledby="education-heading" class="scroll-mt-24 border-t border-[var(--color-border)] px-6 py-16">
  <div class="mx-auto max-w-4xl">
    <h2 id="education-heading" class="text-2xl font-bold sm:text-3xl">{t('education.heading')}</h2>
    <ol class="mt-6 space-y-8 border-l border-[var(--color-border)]">
      {education.map((item) => (
        <li class="relative pl-6">
          <span class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 rounded-full bg-[var(--color-accent)]"></span>
          <h3 class="font-semibold">{item.institution} — {item.degree}</h3>
          <p class="font-mono text-sm text-[var(--color-accent)]">{item.detail}</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">{item.period}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
