---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { projects } = profile[lang];
---

<section id="projects" aria-labelledby="projects-heading" class="scroll-mt-24 border-t border-[var(--color-border)] px-6 py-16">
  <div class="mx-auto max-w-4xl" data-reveal>
    <h2 id="projects-heading" class="text-2xl font-bold sm:text-3xl">{t('projects.heading')}</h2>
    <p class="mt-3 max-w-2xl text-[var(--color-text-muted)]">{t('projects.intro')}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <li>
          <article
            aria-labelledby={`project-${project.name.replace(/\s+/g, '-').toLowerCase()}`}
            class="group flex h-full flex-col rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] p-5 shadow-[var(--shadow-card)] transition-colors hover:border-[var(--color-accent-muted)]"
          >
            <div class="flex items-start justify-between gap-2">
              <h3 id={`project-${project.name.replace(/\s+/g, '-').toLowerCase()}`} class="font-semibold transition-colors group-hover:text-[var(--color-accent)]">
                {project.name}
              </h3>
              {project.badge && <span class="whitespace-nowrap font-mono text-xs text-[var(--color-accent)]">{project.badge}</span>}
            </div>
            <p class="mt-2 flex-1 text-sm text-[var(--color-text-muted)]">{project.description}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {project.tech.map((tech) => (
                <li class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 font-mono text-xs text-[var(--color-text-muted)]">
                  {tech}
                </li>
              ))}
            </ul>
            {project.url ? (
              <a
                href={project.url}
                rel="noopener noreferrer"
                target="_blank"
                class="mt-4 inline-block text-sm font-medium text-[var(--color-accent)] hover:underline"
              >
                {t('projects.viewRepo')} →
              </a>
            ) : (
              <p class="mt-4 text-sm text-[var(--color-text-muted)]">{t('projects.noRepo')}</p>
            )}
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
