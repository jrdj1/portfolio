---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { location } = profile[lang];
---

<section id="hero" aria-label={t('hero.eyebrow')} class="relative scroll-mt-24 overflow-hidden px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 left-1/2 h-96 w-[36rem] -translate-x-1/2 rounded-full bg-[var(--color-accent)] opacity-[0.12] blur-[100px]"
  >
  </div>

  <div class="relative mx-auto max-w-4xl">
    <p class="font-mono text-sm text-[var(--color-accent)]">{t('hero.eyebrow')}</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">{t('hero.headline')}</h1>
    <p class="mt-4 font-mono text-sm text-[var(--color-text-muted)]">
      {t('hero.name')} · {t('hero.role')} · {location}
    </p>
    <p class="mt-8 flex flex-wrap gap-4">
      <a
        href={`${getRelativeLocaleUrl(lang, '/')}#projects`}
        class="rounded bg-[var(--color-accent)] px-5 py-2.5 font-medium text-[var(--color-bg)] transition-transform hover:-translate-y-0.5 hover:opacity-90"
      >
        {t('hero.cta.projects')}
      </a>
      <a
        href={`${getRelativeLocaleUrl(lang, '/')}#contact`}
        class="rounded border border-[var(--color-border)] px-5 py-2.5 font-medium transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('hero.cta.contact')}
      </a>
    </p>
  </div>
</section>
