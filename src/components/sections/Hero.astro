---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { heroTagline, location } = profile[lang];
---

<section id="hero" aria-label={t('hero.eyebrow')} class="scroll-mt-24 px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="mx-auto max-w-4xl">
    <p class="font-mono text-sm text-[var(--color-accent)]">{t('hero.eyebrow')} · {location}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{t('hero.name')}</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-muted)]">{heroTagline}</p>
    <p class="mt-8 flex flex-wrap gap-4">
      <a
        href={`${getRelativeLocaleUrl(lang, '/')}#projects`}
        class="rounded bg-[var(--color-accent)] px-5 py-2.5 font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90"
      >
        {t('hero.cta.projects')}
      </a>
      <a
        href={`${getRelativeLocaleUrl(lang, '/')}#contact`}
        class="rounded border border-[var(--color-border)] px-5 py-2.5 font-medium transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('hero.cta.contact')}
      </a>
    </p>
  </div>
</section>
