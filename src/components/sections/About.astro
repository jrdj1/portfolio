---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../content/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { aboutBody, languages } = profile[lang];
---

<section id="about" aria-labelledby="about-heading" class="scroll-mt-24 border-t border-[var(--color-border)] px-6 py-16">
  <div class="mx-auto max-w-4xl">
    <h2 id="about-heading" class="text-2xl font-bold sm:text-3xl">{t('about.heading')}</h2>
    <p class="mt-4 max-w-2xl text-[var(--color-text-muted)]">{aboutBody}</p>

    <h3 class="mt-8 font-mono text-sm text-[var(--color-accent)]">{t('about.languagesHeading')}</h3>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-[var(--color-text-muted)]">
      {languages.map((language) => (
        <li>{language.name} <span class="text-[var(--color-text-muted)]">({language.level})</span></li>
      ))}
    </ul>
  </div>
</section>
