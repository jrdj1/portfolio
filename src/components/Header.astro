---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { routePath, type RouteKey } from '../i18n/routes';

interface Props {
  lang: Locale;
  /** Ruta actual, para que el selector de idioma lleve a la pagina equivalente. */
  route?: RouteKey;
}

const { lang, route = 'home' } = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === 'es' ? 'en' : 'es';

const navItems: Array<{ label: string; href: string }> = [
  { label: t('nav.projects'), href: routePath(lang, 'projects') },
  { label: t('nav.tech'), href: routePath(lang, 'tech') },
  { label: t('nav.blog'), href: routePath(lang, 'blog') },
  { label: t('nav.about'), href: routePath(lang, 'about') },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-[var(--color-accent)] focus:px-3 focus:py-2 focus:text-[var(--color-bg)]"
>
  Skip to content
</a>
<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/85 backdrop-blur">
  <nav aria-label="Navegación principal" class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href={routePath(lang, 'home')} class="font-mono text-sm font-bold text-[var(--color-accent)]" aria-label={t('hero.name')}>
        JJV
      </a>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm text-[var(--color-text-muted)]">
        {navItems.map(({ label, href }) => (
          <li>
            <a href={href} class="transition-colors hover:text-[var(--color-accent)]">{label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex items-center gap-2">
      <a
        href={routePath(otherLang, route)}
        hreflang={otherLang}
        rel="alternate"
        class="rounded border border-[var(--color-border)] px-3 py-1 font-mono text-sm text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('nav.langSwitch')}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t('nav.themeToggle')}
        class="rounded border border-[var(--color-border)] p-1.5 text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        <svg class="icon-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.5 12h2M19.5 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>
