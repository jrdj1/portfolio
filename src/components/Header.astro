---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === 'es' ? 'en' : 'es';
---

<header>
  <nav aria-label="Navegación principal">
    <ul>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#about`}>{t('nav.about')}</a></li>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#skills`}>{t('nav.skills')}</a></li>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#projects`}>{t('nav.projects')}</a></li>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#experience`}>{t('nav.experience')}</a></li>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#education`}>{t('nav.education')}</a></li>
      <li><a href={`${getRelativeLocaleUrl(lang, '/')}#contact`}>{t('nav.contact')}</a></li>
    </ul>
    <a href={getRelativeLocaleUrl(otherLang, '/')} hreflang={otherLang} rel="alternate">
      {t('nav.langSwitch')}
    </a>
  </nav>
</header>
